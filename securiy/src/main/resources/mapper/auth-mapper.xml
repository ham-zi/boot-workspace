<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  <mapper namespace="com.ds.security.auth.model.dao.AuthMapper">
  
  <select id="findByUserId" resultType="MemberDto">
  	SELECT
  	       USER_NO 
  	     , USER_ID
  	     , USER_PWD
  	     , USER_NAME
  	     , role
  	     , EMAIL
  	     , STATUS
  	  FROM
  	       DS_MEMBER
  	 WHERE
  	       USER_ID = #{username}
  	   AND
  	       STATUS = 'Y'  
  </select>
  	
  
  
  
  </mapper>